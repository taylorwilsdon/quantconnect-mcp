# Copy to .env, fill in, and load it explicitly with
# `uv run --env-file .env quantconnect-mcp`. The server never reads .env on its own.
# Never commit .env.

# Required: your user ID and API token from https://www.quantconnect.com/settings/
QUANTCONNECT_USER_ID=
QUANTCONNECT_API_TOKEN=

# Optional: organization for new projects and the Object Store. Defaults to your
# preferred organization. Find it in https://www.quantconnect.com/organization/<id>
QUANTCONNECT_ORGANIZATION_ID=

# Optional: seconds to wait for a QuantConnect API response.
REQUEST_TIMEOUT=60

# Transport: stdio (default, for desktop MCP clients) or streamable-http.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp

# Required whenever MCP_HOST is not a loopback address. Clients must send
# "Authorization: Bearer <token>".
MCP_AUTH_TOKEN=

# DEBUG, INFO, WARNING, or ERROR. Logs go to stderr.
LOG_LEVEL=INFO
